generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DayOfWeek {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}

model User {
  id                  String              @id @default(cuid())
  phone               String              @unique
  passwordHash        String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dailyCalorieLimit   Int?
  resetDay            DayOfWeek?
  desiredWeight       Int?
  mealScheduleEnabled Boolean             @default(false)
  weights             WeightEntry[]
  foodEntries         FoodEntry[]
  favoriteFoods       FavoriteFood[]
  mealScheduleEntries MealScheduleEntry[]
}

model MealScheduleEntry {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeMinutes Int
  calories    Int
  favorites   MealScheduleFavorite[]

  @@unique([userId, timeMinutes])
}

model MealScheduleFavorite {
  mealScheduleEntryId String
  favoriteFoodId      String
  mealScheduleEntry   MealScheduleEntry @relation(fields: [mealScheduleEntryId], references: [id], onDelete: Cascade)
  favoriteFood        FavoriteFood      @relation(fields: [favoriteFoodId], references: [id], onDelete: Cascade)

  @@id([mealScheduleEntryId, favoriteFoodId])
  @@index([favoriteFoodId])
}

model WeightEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt DateTime @default(now()) //когда взвешивался (серверное время)
  weight     Float //значение веса кг

  @@index([userId, measuredAt])
}

model FoodEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt  DateTime @default(now()) //время приёма пищи
  title    String
  calories Int

  @@index([userId, eatenAt])
}

model FavoriteFood {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  calories            Int
  mealScheduleEntries MealScheduleFavorite[]

  @@index([userId])
}
